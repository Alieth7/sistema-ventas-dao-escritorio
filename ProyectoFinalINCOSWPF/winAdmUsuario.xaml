<Window x:Class="ProyectoFinalINCOSWPF.winAdmUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoFinalINCOSWPF"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
     TextElement.Foreground="{DynamicResource MaterialDesignBody}"
     TextElement.FontWeight="Regular"
     TextElement.FontSize="13"
     TextOptions.TextFormattingMode="Ideal"
     TextOptions.TextRenderingMode="Auto"
     Background="{DynamicResource MaterialDesignPaper}"
     FontFamily="{DynamicResource MaterialDesignFont}"
        
        Title="winAdmUsuario" BorderBrush="#795548" BorderThickness="2" Height="450" Width="850" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" Loaded="Window_Loaded" Cursor="Hand">
    <Grid>

        <StackPanel>
            <!--color primario-->
            <Grid Height="30" Background="#795548">

                <Button x:Name="btn_close" Width="30" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Right" Foreground="White" Padding="0" Click="btn_close_Click"
                        
                        >
                    <materialDesign:PackIcon Kind="Close" Width="25" Height="25"/>
                </Button>


            </Grid>
            <Label Content="ADMINISTRACION DE USUARIOS" HorizontalAlignment="Center" Foreground="#795548" FontSize="16" FontWeight="DemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <StackPanel Orientation="Vertical" Margin="0 10 0 5">
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Label Content="Ci:                 " FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtCi" Width="200" Margin="10 0 0 0" HorizontalAlignment="Right"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5 ">
                        <Label Content="Nombres:" FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtNombres" Width="215" Margin="10 0 0 0"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Primer Apellido:" FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtPrimerAp" Width="185" Margin="10 0 0 0"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Segundo Apellido:" FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtSegundoAp" Width="160" Margin="10 0 0 0"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Fecha de Nacimiento:" FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                       
                        <DatePicker Name="txtFechaNacimiento" HorizontalAlignment="Right" Width="160"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Sexo:              " FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        
                        <ComboBox x:Name="txtSexo" HorizontalAlignment="Left" Width="200">
                            <ComboBoxItem Content="F"/>
                            <ComboBoxItem Content="M"/>
                        </ComboBox>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Rol:                 " FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="txtRol" HorizontalAlignment="Left" Width="200">
                            <ComboBoxItem Content="Cajero"/>
                            <ComboBoxItem Content="Administrador"/>
                        </ComboBox>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Nombre de Usuario:" FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtNombreUsuario" Width="165" Margin="10 0 0 0"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Contraseña:" FontSize="12" Foreground="#795548" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtContrasenia" Width="210" Margin="10 0 0 0"/>

                    </StackPanel>
                </StackPanel>


                <StackPanel Orientation="Vertical">
                    <DataGrid Height="300" Width="525" x:Name="dgvDatos" Margin="0 0 5 5" BorderBrush="#795548" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="dgvDatos_SelectionChanged"/>
                    
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" >
                <Button x:Name="btnGenerarUsuContra" Content="Generar usuario y contraseña" Width="220" Margin="10 5 10 5" Click="btnGenerarUsuContra_Click"/>
                
                <Button x:Name="btnInsert" Content="Insertar" Width="100" Margin="10 5 10 5" Click="btnInsert_Click"/>
                <Button x:Name="btnUpdate" Content="Modificar" Width="100" Margin="5 5 10 5" Cursor="Hand" Click="btnUpdate_Click"/>
                <Button x:Name="btnDelete" Content="Eliminar" Width="100" Margin="5 5 10 5" Click="btnDelete_Click"/>
                <Button x:Name="btnSave" Content="Guardar" Width="100" Margin="5 5 10 5" Click="btnSave_Click"/>
                <Button x:Name="btnCancel" Content="Cancelar" Width="100" Margin="5 5 10 5" Background="Brown" Click="btnCancel_Click"/>



            </StackPanel>

        </StackPanel>


    </Grid>
</Window>
